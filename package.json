{
  "name": "prxxie-home-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n shell,about,posts,pets,shikaku,sokoban,slitherlink -c blue,green,yellow,magenta,cyan,white,red \"pnpm -F shell dev\" \"pnpm -F about dev:watch\" \"pnpm -F posts dev:watch\" \"pnpm -F pets dev:watch\" \"pnpm -F shikaku dev:watch\" \"pnpm -F sokoban dev:watch\" \"pnpm -F slitherlink dev:watch\"",
    "build": "pnpm -r run build",
    "build:static": "bash scripts/build-static.sh",
    "build:facts": "node scripts/build-facts.mjs",
    "a11y": "node scripts/a11y-gate.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.14.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^17.0.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
